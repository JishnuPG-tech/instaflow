# Auto-detect text files and normalize line endings to LF
* text=auto eol=lf

# Explicitly declare text files that must use LF
*.kt text eol=lf
*.kts text eol=lf
*.py text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.properties text eol=lf
gradlew text eol=lf

# Binary files
*.jar binary
*.aar binary
